msgstr "LOGINTEL / مساحة العمل"

msgid "Your workspace"
msgstr "مساحة عملك"

msgid "A clear view of your LogIntel record collection."
msgstr "نظرة واضحة على مجموعة سجلات LogIntel الخاصة بك."

msgid "Add a record"
msgstr "إضافة سجل"

msgid "Total records"
msgstr "إجمالي السجلات"

msgid "Records currently in your workspace"
msgstr "السجلات الموجودة حاليًا في مساحة عملك"

msgid "Workspace summary"
msgstr "ملخص مساحة العمل"

msgid "Records in your workspace"
msgstr "السجلات في مساحة عملك"

msgid "Workspace tools"
msgstr "أدوات مساحة العمل"

msgid "Manage with clarity."
msgstr "إدارة واضحة."

msgid "Search, import, review, and export your records."
msgstr "ابحث عن سجلاتك واستوردها وراجعها وصدّرها."

msgid "GET STARTED"
msgstr "ابدأ الآن"

msgid "What would you like to do?"
msgstr "ما الذي ترغب في القيام به؟"

msgid "Browse records"
msgstr "تصفح السجلات"

msgid "Review and manage the records in your workspace."
msgstr "راجع السجلات في مساحة عملك وأدِرها."

msgid "Search records"
msgstr "البحث في السجلات"

msgid "Find a record by domain, URL, identifier, or IP."
msgstr "اعثر على سجل حسب النطاق أو الرابط أو المعرّف أو عنوان IP."

msgid "Import a file"
msgstr "استيراد ملف"

msgid "Bring records in from a supported text file."
msgstr "أضف سجلات من ملف نصي مدعوم."

msgid "Export data"
msgstr "تصدير البيانات"

msgid "Download your records as CSV or JSON."
msgstr "نزّل سجلاتك بصيغة CSV أو JSON."

msgid "Handle sensitive information carefully."
msgstr "تعامل مع المعلومات الحساسة بعناية."

msgid "Record exports include all record fields. Store downloaded files securely and share them only with authorized people."
msgstr "تتضمن ملفات تصدير السجلات جميع الحقول. احفظ الملفات التي نزّلتها بأمان ولا تشاركها إلا مع أشخاص مخوّلين."

msgid "Browse the records saved in your workspace."
msgstr "تصفح السجلات المحفوظة في مساحة عملك."

msgid "Export CSV"
msgstr "تصدير CSV"

msgid "Export JSON"
msgstr "تصدير JSON"

msgid "Add record"
msgstr "إضافة سجل"

msgid "All records"
msgstr "كل السجلات"

