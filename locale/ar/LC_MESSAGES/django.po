"أنت على وشك حذف %(name)s نهائيًا، المستخدم بواسطة %(counter)s سجل واحد."
msgstr[2] ""
"أنت على وشك حذف %(name)s نهائيًا، المستخدم بواسطة %(counter)s سجلين."
msgstr[3] ""
"أنت على وشك حذف %(name)s نهائيًا، المستخدم بواسطة %(counter)s سجلات."
msgstr[4] ""
"أنت على وشك حذف %(name)s نهائيًا، المستخدم بواسطة %(counter)s سجلًا."
msgstr[5] "أنت على وشك حذف %(name)s نهائيًا، المستخدم بواسطة %(counter)s سجل."

