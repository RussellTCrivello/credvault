# ======================================================================
# CredVault — Environment Configuration Reference
# ======================================================================
#
# Copy this file to .env (or set the variables in your shell) and adjust
# the values for your environment.
#
# On Windows PowerShell:
#   $env:POSTGRES_DB = "credvault"
#   $env:POSTGRES_USER = "credvault"
#   $env:POSTGRES_PASSWORD = "yourpassword"
#
# On Windows CMD:
#   set POSTGRES_DB=credvault
#   set POSTGRES_USER=credvault
#   set POSTGRES_PASSWORD=yourpassword
#
# On Linux/macOS:
#   export POSTGRES_DB=credvault
#
# ======================================================================


# ======================================================================
# PostgreSQL connection
# ======================================================================
POSTGRES_DB=credvault
POSTGRES_USER=credvault
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432


# ======================================================================
# Import performance tuning
# ======================================================================

# Rows per import batch.  Higher = fewer transactions, more memory.
# Default: 250000 (auto-tuned downward if free memory is low).
#
# Tuning guidance:
#   8 GB RAM  -> 100000-200000
#   16 GB RAM -> 250000-500000
#   32 GB RAM -> 500000-1000000
#
# The importer auto-sizes based on free memory when this is unset.
VAULT_IMPORT_BATCH_ROWS=250000

# Parse worker processes for CPU-bound line parsing.
# Windows default: 1 (inline parsing, because spawn has process-startup cost).
# Linux default: min(4, cpu_count).
#
# Tuning guidance:
#   4-core CPU,  16 GB RAM -> VAULT_IMPORT_WORKERS=4
#   8-core CPU,  32 GB RAM -> VAULT_IMPORT_WORKERS=6
#   16-core CPU, 64 GB RAM -> VAULT_IMPORT_WORKERS=8
#
# Each worker consumes ~50 MB RSS.  Do not exceed physical cores.
VAULT_IMPORT_WORKERS=4

# Seconds between NDJSON progress events during streaming import.
# Lower = more responsive UI, higher network/CPU overhead.
# Default: 1.0 (minimum 0.1).
VAULT_PROGRESS_INTERVAL=1.0


# ======================================================================
# Optional: Zstandard (.zst) compressed file support
# ======================================================================
# Uncomment to enable .zst streaming decompression.
# .gz (gzip) and .bz2 (bzip2) work without any extra package.
#
# pip install zstandard


# ======================================================================
# Windows-specific tuning
# ======================================================================
#
# Windows Defender exclusions (improves import speed 2-5x):
#   Add these paths to Windows Defender exclusion list:
#     - The Python installation directory
#     - The PostgreSQL data directory
#     - The CredVault project directory
#     - The import data source directory
#
# Long path support (>260 characters):
#   Enable via registry or Group Policy:
#     Computer Configuration > Administrative Templates > System >
#     Filesystem > Enable Win32 long paths
#   Or:  reg add "HKLM\SYSTEM\CurrentControlSet\Control\FileSystem" /v LongPathsEnabled /t REG_DWORD /d 1 /f
#
# PostgreSQL tuning for large imports:
#   shared_buffers = 25% of RAM (e.g. 4GB for 16GB system)
#   work_mem = 256MB (or higher for very large batches)
#   maintenance_work_mem = 1GB (for index rebuilds in --fast mode)
#   effective_io_concurrency = 200 (SSD/NVMe)
#   max_wal_size = 4GB (reduces checkpoint frequency during bulk load)
#
# SSD/NVMe storage:
#   Place the PostgreSQL data directory on NVMe for best bulk-load speed.
#   Ensure the drive has at least 2x the import data size free.


# ======================================================================
# Optional debugging
# ======================================================================

# Print per-section timing during durable batch flush.
# VAULT_DEBUG_TIMING=1
